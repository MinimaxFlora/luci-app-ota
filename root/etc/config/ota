config ota 'config'
	# URL of the JSON update index. Empty by default: the firmware build (or
	# the user) has to point this at its own index, https unless
	# allow_insecure is enabled.
	option api_url ''

	# Optional manual device key. Leave empty to detect it automatically.
	option device ''

	# Acceleration site used for GitHub download URLs. It is used as a plain
	# prefix: https://gh-proxy.kejizero.xyz/https://github.com/...
	# Leave empty (or set "direct") to download straight from GitHub.
	option download_proxy 'https://gh-proxy.kejizero.xyz'

	# Used instead of download_proxy when that is set to "custom".
	option download_proxy_custom ''

	# Check for updates automatically when the page is opened
	option auto_check '1'

	# Default state of "keep settings" on the install step
	option keep_settings '1'

	# Let sysupgrade validate the image metadata before flashing
	option verify_image '1'

	# Use IPv4 only for index/download requests (helps on broken IPv6 setups)
	option ipv4_only '1'

	# Allow plain http:// index and download URLs and skip TLS verification
	option allow_insecure '0'
