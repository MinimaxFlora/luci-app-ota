msgid "OTA Firmware Update"
msgstr "在线升级"

msgid "Overview"
msgstr "概览"

msgid "Configuration"
msgstr "配置"

msgid "Grant access to the OTA firmware update functionality"
msgstr "授予在线升级功能的访问权限"

msgid "Check for new firmware, download it and install it with sysupgrade."
msgstr "检查并下载新固件，然后通过 sysupgrade 写入。"

msgid "Current firmware"
msgstr "当前固件"

msgid "Model"
msgstr "设备型号"

msgid "Firmware version"
msgstr "固件版本"

msgid "Build date"
msgstr "构建时间"

msgid "Target"
msgstr "目标平台"

msgid "Architecture"
msgstr "架构"

msgid "Device key"
msgstr "设备标识"

msgid "Update index"
msgstr "更新索引"

msgid "not configured"
msgstr "未配置"

msgid "The OTA backend did not respond."
msgstr "OTA 后台没有响应。"

msgid "Retry"
msgstr "重试"

msgid "Firmware update"
msgstr "固件更新"

msgid "Press \"Check for updates\" to look for a new firmware."
msgstr "点击“检查更新”查找新固件。"

msgid "No update index has been configured for this firmware yet."
msgstr "此固件尚未配置更新索引。"

msgid "Open the configuration page"
msgstr "打开配置页面"

msgid "Check for updates"
msgstr "检查更新"

msgid "Checking for updates…"
msgstr "正在检查更新…"

msgid "This firmware is up to date"
msgstr "已是最新固件"

msgid "Installed version: %s"
msgstr "已安装版本：%s"

msgid "Last checked: %s"
msgstr "上次检查：%s"

msgid "Check again"
msgstr "重新检查"

msgid "A new firmware is available"
msgstr "发现新固件"

msgid "A new firmware is available."
msgstr "发现可用的新固件。"

msgid "Installed version"
msgstr "已安装版本"

msgid "Available version"
msgstr "可用版本"

msgid "Installed build"
msgstr "已安装版本构建时间"

msgid "Available build"
msgstr "新固件构建时间"

msgid "Size"
msgstr "大小"

msgid "File"
msgstr "文件名"

msgid "unknown"
msgstr "未知"

msgid "SHA256"
msgstr "SHA256"

msgid "Download firmware"
msgstr "下载固件"

msgid "Changelog"
msgstr "更新日志"

msgid "Downloading firmware"
msgstr "正在下载固件"

msgid "Cancel download"
msgstr "取消下载"

msgid "Starting download…"
msgstr "正在开始下载…"

msgid "about %s left"
msgstr "剩余约 %s"

msgid "downloading…"
msgstr "下载中…"

msgid "Firmware downloaded and verified"
msgstr "固件已下载并通过校验"

msgid "Firmware downloaded and verified."
msgstr "固件已下载并通过校验。"

msgid "Version"
msgstr "版本"

msgid "Keep settings and retain the current configuration"
msgstr "保留设置并继续使用当前配置"

msgid "Install firmware"
msgstr "安装固件"

msgid "Discard download"
msgstr "放弃下载"

msgid "The device will reboot after the firmware has been written."
msgstr "固件写入完成后设备会自动重启。"

msgid "Update failed"
msgstr "更新失败"

msgid "Download again"
msgstr "重新下载"

msgid "Firmware version %s will be written to the device."
msgstr "将把固件版本 %s 写入设备。"

msgid "The current configuration will be kept."
msgstr "当前的配置将被保留。"

msgid "The current configuration will be erased."
msgstr "当前的配置将被清除。"

msgid "The device reboots automatically, do not power it off during the process."
msgstr "设备会自动重启，过程中请不要断电。"

msgid "The update takes a few minutes. The network may be unreachable during that time."
msgstr "更新需要几分钟，期间网络可能无法访问。"

msgid "Cancel"
msgstr "取消"

msgid "Start installation"
msgstr "开始安装"

msgid "Writing firmware, the device will reboot…"
msgstr "正在写入固件，设备即将重启…"

msgid "Do not power off the device and do not close the browser."
msgstr "请不要关闭设备电源或浏览器。"

msgid "The page reconnects automatically once the device is back."
msgstr "设备恢复后页面会自动重连。"

msgid "Waiting for the device to reboot…"
msgstr "正在等待设备重启…"

msgid "The firmware is being written, please do not leave this page."
msgstr "固件正在写入，请不要离开本页面。"

msgid "Download canceled."
msgstr "下载已取消。"

msgid "Cancel failed: %s"
msgstr "取消失败：%s"

msgid "Download failed: %s"
msgstr "下载失败：%s"

msgid "Check failed: %s"
msgstr "检查失败：%s"

msgid "Could not start the installation: %s"
msgstr "无法开始安装：%s"

msgid "No update index URL is configured yet."
msgstr "尚未配置更新索引地址。"

msgid "The update index URL must use HTTPS. Enable \"Allow insecure connections\" in the configuration to allow plain HTTP."
msgstr "更新索引必须使用 HTTPS。如确实需要 HTTP，请在配置中开启“允许不安全的连接”。"

msgid "Could not download the update index. Please check the network connection."
msgstr "无法获取更新索引，请检查网络连接。"

msgid "Neither curl nor uclient-fetch is installed on this device."
msgstr "设备上既没有 curl 也没有 uclient-fetch。"

msgid "The update index is not valid JSON."
msgstr "更新索引不是有效的 JSON。"

msgid "The update index does not contain a firmware image for this device."
msgstr "更新索引中没有适用于此设备的固件。"

msgid "Cannot tell whether a newer firmware is available: the index entry has neither a build date nor a version."
msgstr "无法判断是否有新固件：索引条目既没有构建时间也没有版本号。"

msgid "Please check for updates first."
msgstr "请先检查更新。"

msgid "The index entry has no SHA256 checksum. The download was blocked for safety reasons."
msgstr "索引条目缺少 SHA256 校验值，出于安全考虑已阻止下载。"

msgid "Not enough free space in /tmp to download this firmware."
msgstr "临时空间（/tmp）不足，无法下载此固件。"

msgid "The firmware is not completely downloaded yet."
msgstr "固件尚未下载完成。"

msgid "/sbin/sysupgrade is not available on this system."
msgstr "系统中没有 /sbin/sysupgrade。"

msgid "The downloaded image failed the SHA256 verification and was discarded."
msgstr "下载的镜像未通过 SHA256 校验，已删除。"

msgid "sysupgrade rejected the downloaded image (wrong device or broken file)."
msgstr "sysupgrade 拒绝了下载的镜像（设备不匹配或文件损坏）。"

msgid "The download failed."
msgstr "下载失败。"

msgid "The downloaded image could not be moved into place."
msgstr "无法将下载的镜像移动到目标位置。"

msgid "The OTA backend could not be executed."
msgstr "无法执行 OTA 后台程序。"

msgid "Unknown error."
msgstr "未知错误。"

msgid "Configure where LuCI looks for firmware updates and how they are handled."
msgstr "配置固件更新的来源以及处理方式。"

msgid "Settings"
msgstr "设置"

msgid "The update index is a small JSON file that lists the firmware images available for each device. It is published by whoever builds the firmware."
msgstr "更新索引是一个小型的 JSON 文件，按设备列出可用的固件镜像，由固件构建者发布。"

msgid "Update index URL"
msgstr "更新索引地址"

msgid "URL of the JSON update index. It has to be reachable from the router itself, not from the browser."
msgstr "JSON 更新索引的地址。该地址必须能被路由器本身访问，而不是浏览器。"

msgid "An update index URL is required."
msgstr "必须填写更新索引地址。"

msgid "The URL has to start with http:// or https://."
msgstr "地址必须以 http:// 或 https:// 开头。"

msgid "Key that identifies this device in the update index. Leave empty to detect it automatically from the running firmware."
msgstr "在更新索引中标识此设备的键名。留空则根据当前固件自动识别。"

msgid "detect automatically"
msgstr "自动识别"

msgid "Check on page load"
msgstr "打开页面时检查"

msgid "Look for a new firmware when the overview page is opened and the last check is older than ten minutes."
msgstr "打开概览页面且上次检查超过十分钟时，自动检查是否有新固件。"

msgid "Keep settings by default"
msgstr "默认保留设置"

msgid "Preselect the \"keep settings\" option before installing a firmware."
msgstr "安装固件前默认勾选“保留设置”。"

msgid "Validate the image before installing"
msgstr "安装前校验镜像"

msgid "Let sysupgrade check the downloaded image for this device right after the download. A rejected image is discarded."
msgstr "下载完成后立即用 sysupgrade 校验镜像是否适用于此设备，被拒绝的镜像会被删除。"

msgid "Use IPv4 only"
msgstr "仅使用 IPv4"

msgid "Restrict the index and firmware downloads to IPv4. Helps on networks with broken IPv6 connectivity."
msgstr "限制索引和固件下载只使用 IPv4，适用于 IPv6 连接不正常的环境。"

msgid "Allow insecure connections"
msgstr "允许不安全的连接"

msgid "Allow plain http:// URLs and skip TLS certificate verification. Only enable this if you really have to."
msgstr "允许使用 http:// 地址并跳过 TLS 证书校验。除非确有必要，否则不要开启。"

msgid "Looked up key(s): %s"
msgstr "已尝试的设备标识：%s"

msgid "Keys in the index: %s"
msgstr "索引中的设备标识：%s"
